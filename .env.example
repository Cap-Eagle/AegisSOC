# Documentation-only template; no application consumes these variables yet.
# Copy to an ignored .env only when implementation is approved.
# Values are placeholders, not production credentials or security controls.
AEGIS_ENV=development
AEGIS_LOG_LEVEL=INFO

# Planned backend: bind locally; explicit origins rather than a wildcard.
API_HOST=127.0.0.1
API_PORT=8000
CORS_ALLOWED_ORIGINS=http://localhost:5173

# PostgreSQL placeholders. Inside future Compose, the host will be postgres.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=aegissoc
POSTGRES_USER=aegissoc
POSTGRES_PASSWORD=replace_with_local_secret
# Database URL will be assembled from these fields; avoid logging it.

# Vite variables are public in the browser. Never put credentials here.
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Planned local-only storage; all paths are ignored by Git.
DATASET_DIR=./datasets
ARTIFACT_DIR=./artifacts
UPLOAD_DIR=./uploads

# Intended safe defaults; implementation must enforce these server-side.
AI_EXPLANATIONS_ENABLED=false
RESPONSE_APPROVAL_REQUIRED=true
# No OpenAI key is required for Phase 1. If enabled later, server-side only.
OPENAI_API_KEY=
